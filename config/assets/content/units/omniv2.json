// VECTA — Omni-equivalent payload unit with custom Vecta airframe
// Vela and Aegires body parts removed.
// Gameplay stats, abilities, and weapon projectiles match Omni.
// Decorative bulletless weapon removed.
// Weapon positions and visual construction adjusted.

type: payload
name: vecta
description: "Fires plasma bullets that split into piercing lasers and damage enemy targets and repair allied structures. Occasionally fires a devastating missile barrage. Capable of carrying large ground units and blocks."
details: ""

// flight
flying: true
lowAltitude: true
flyingLayer: 91.9
engineLayer: 89.97
omniMovement: true
faceTarget: true
circleTarget: false
speed: 1
rotateSpeed: 0.85
strafePenalty: 0.2

// stats
health: 16000
armor: 14
hitSize: 38
range: 290
maxRange: 310
aimDst: 120
itemCapacity: 280
buildSpeed: 0.01
buildBeamOffset: 36
mineTier: 4
mineSpeed: 9.5
payloadCapacity: 1024

// targeting & control
canAttack: true
targetAir: true
targetGround: true
targetable: true
hittable: true
autoFindTarget: true
playerControllable: true
logicControllable: true
useUnitCap: true
coreUnitDock: false

// visuals
drawBody: false
drawShields: false
engineSize: 0
softShadowRegion: particle
loopSound: loopHover
loopSoundVolume: 0.58
trailLength: 16
trailScl: 3.6
lightRadius: 110

research: quad

abilities: [
{
type: ShieldRegenFieldAbility
amount: 100
max: 1100
reload: 90
range: 60
}
]

// Exactly two engines at the original primary-engine position.
engines: [
{ radius: 6.2, x: 9.35, y: -48.85, rotation: 270 }
{ radius: 6.2, x: -9.35, y: -48.85, rotation: 270 }
]

